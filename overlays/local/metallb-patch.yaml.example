apiVersion: v1
kind: Service
metadata:
  name: taranac-vip-tcp
  namespace: taranac
  annotations:
    metallb.universe.tf/allow-shared-ip: "taranac-lb"
spec:
  loadBalancerIP: 192.168.1.50
  externalTrafficPolicy: Local
---
apiVersion: v1
kind: Service
metadata:
  name: taranac-vip-udp
  namespace: taranac
  annotations:
    metallb.universe.tf/allow-shared-ip: "taranac-lb"
spec:
  loadBalancerIP: 192.168.1.50
  externalTrafficPolicy: Local